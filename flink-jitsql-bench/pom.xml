<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>ai.beestream</groupId>
		<artifactId>flink-jitsql-parent</artifactId>
		<version>0.1.0-SNAPSHOT</version>
	</parent>

	<artifactId>flink-jitsql-bench</artifactId>
	<name>flink-jitsql : bench</name>

	<description>
		Runnable examples and benchmarks for the provider.

		They live here rather than in flink-examples because every one of them needs a device.
		Three are ordinary Flink SQL and need the provider only on the classpath -- which is the
		point they exist to make -- but they assert that offload actually happened, so without it
		they fail rather than passing trivially. The other three drive the engines directly,
		because no planner path reaches an aggregate or a join yet.
	</description>

	<dependencies>
		<dependency>
			<groupId>ai.beestream</groupId>
			<artifactId>flink-jitsql-plugin</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-table-api-java-bridge</artifactId>
			<version>${flink.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-table-planner-loader</artifactId>
			<version>${flink.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-table-runtime</artifactId>
			<version>${flink.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-clients</artifactId>
			<version>${flink.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-connector-datagen</artifactId>
			<version>${flink.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>io.github.beehive-lab</groupId>
			<artifactId>tornado-api</artifactId>
			<version>${tornado.version}</version>
			<scope>provided</scope>
		</dependency>
			<dependency>
			<groupId>io.github.beehive-lab</groupId>
			<artifactId>tornado-cudf</artifactId>
			<version>${tornado.version}</version>
			<scope>provided</scope>
		</dependency>
		<!--
			jitllm is compiled against but never packaged. It is deployed into the distribution's
			lib/, the same way the provider jar is, which is not a packaging convenience but a
			requirement: a model kept resident across jobs has to be held by a class the parent
			classloader owns, and anything inside a job jar is discarded with that job's
			classloader. See ResidentEngines.
		-->
		<dependency>
			<groupId>io.github.beehive-lab</groupId>
			<artifactId>jitllm</artifactId>
			<version>${jitllm.version}</version>
			<scope>provided</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
				One runnable jar per example, named after it, exactly as flink-examples-table did
				before these moved here. The run scripts under the provider module look the jars up
				by that bare name, and a benchmark is submitted with `flink run`, so the manifest
				has to name the class.

				Each execution packs one example and nothing else, so anything shared has to be
				named in every one of them or it is missing at submit time. BenchData is the only
				such class; it is a kilobyte, and the examples that do not use it are no worse for
				carrying it.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.4.1</version>
				<executions>
					<execution>
						<id>GpuOffloadExample</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>GpuOffloadExample</classifier>
							<archive>
								<manifestEntries>
									<program-class>ai.beestream.flink.jitsql.bench.GpuOffloadExample</program-class>
								</manifestEntries>
							</archive>
							<includes>
								<include>ai/beestream/flink/jitsql/bench/GpuOffloadExample*</include>
								<include>ai/beestream/flink/jitsql/bench/BenchData*</include>
							</includes>
						</configuration>
					</execution>
					<execution>
						<id>DeviceConformanceSuite</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>DeviceConformanceSuite</classifier>
							<archive>
								<manifestEntries>
									<program-class>ai.beestream.flink.jitsql.bench.DeviceConformanceSuite</program-class>
								</manifestEntries>
							</archive>
							<includes>
								<include>ai/beestream/flink/jitsql/bench/DeviceConformanceSuite*</include>
								<include>ai/beestream/flink/jitsql/bench/BenchData*</include>
							</includes>
						</configuration>
					</execution>
					<execution>
						<id>NearestNeighbourSQLExample</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>NearestNeighbourSQLExample</classifier>
							<archive>
								<manifestEntries>
									<program-class>ai.beestream.flink.jitsql.bench.NearestNeighbourSQLExample</program-class>
								</manifestEntries>
							</archive>
							<includes>
								<include>ai/beestream/flink/jitsql/bench/NearestNeighbourSQLExample*</include>
								<include>ai/beestream/flink/jitsql/bench/BenchData*</include>
							</includes>
						</configuration>
					</execution>
					<execution>
						<id>LogCorpusGenerator</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>LogCorpusGenerator</classifier>
							<archive>
								<manifestEntries>
									<program-class>ai.beestream.flink.jitsql.bench.LogCorpusGenerator</program-class>
								</manifestEntries>
							</archive>
							<includes>
								<include>ai/beestream/flink/jitsql/bench/LogCorpusGenerator*</include>
								<include>ai/beestream/flink/jitsql/bench/BenchData*</include>
							</includes>
						</configuration>
					</execution>
					<execution>
						<id>GrokSQLExample</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>GrokSQLExample</classifier>
							<archive>
								<manifestEntries>
									<program-class>ai.beestream.flink.jitsql.bench.GrokSQLExample</program-class>
								</manifestEntries>
							</archive>
							<includes>
								<include>ai/beestream/flink/jitsql/bench/GrokSQLExample*</include>
								<include>ai/beestream/flink/jitsql/bench/BenchData*</include>
							</includes>
						</configuration>
					</execution>
					<execution>
						<id>MixedTypeVerification</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>MixedTypeVerification</classifier>
							<archive>
								<manifestEntries>
									<program-class>ai.beestream.flink.jitsql.bench.MixedTypeVerification</program-class>
								</manifestEntries>
							</archive>
							<includes>
								<include>ai/beestream/flink/jitsql/bench/MixedTypeVerification*</include>
								<include>ai/beestream/flink/jitsql/bench/BenchData*</include>
							</includes>
						</configuration>
					</execution>
					<execution>
						<id>HaversineSQLExample</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>HaversineSQLExample</classifier>
							<archive>
								<manifestEntries>
									<program-class>ai.beestream.flink.jitsql.bench.HaversineSQLExample</program-class>
								</manifestEntries>
							</archive>
							<includes>
								<include>ai/beestream/flink/jitsql/bench/HaversineSQLExample*</include>
								<include>ai/beestream/flink/jitsql/bench/BenchData*</include>
							</includes>
						</configuration>
					</execution>
					<execution>
						<id>GramParquetSQLExample</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>GramParquetSQLExample</classifier>
							<archive>
								<manifestEntries>
									<program-class>ai.beestream.flink.jitsql.bench.GramParquetSQLExample</program-class>
								</manifestEntries>
							</archive>
							<includes>
								<include>ai/beestream/flink/jitsql/bench/GramParquetSQLExample*</include>
								<include>ai/beestream/flink/jitsql/bench/BenchData*</include>
							</includes>
						</configuration>
					</execution>
					<execution>
						<id>RiskScoringSQLExample</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>RiskScoringSQLExample</classifier>
							<archive>
								<manifestEntries>
									<program-class>ai.beestream.flink.jitsql.bench.RiskScoringSQLExample</program-class>
								</manifestEntries>
							</archive>
							<includes>
								<include>ai/beestream/flink/jitsql/bench/RiskScoringSQLExample*</include>
								<include>ai/beestream/flink/jitsql/bench/BenchData*</include>
							</includes>
						</configuration>
					</execution>
					<execution>
						<id>CudfSortSQLExample</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>CudfSortSQLExample</classifier>
							<archive>
								<manifestEntries>
									<program-class>ai.beestream.flink.jitsql.bench.CudfSortSQLExample</program-class>
								</manifestEntries>
							</archive>
							<includes>
								<include>ai/beestream/flink/jitsql/bench/CudfSortSQLExample*</include>
								<include>ai/beestream/flink/jitsql/bench/BenchData*</include>
							</includes>
						</configuration>
					</execution>
										<execution>
						<id>CudfGroupBySQLExample</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>CudfGroupBySQLExample</classifier>
							<archive>
								<manifestEntries>
									<program-class>ai.beestream.flink.jitsql.bench.CudfGroupBySQLExample</program-class>
								</manifestEntries>
							</archive>
							<includes>
								<include>ai/beestream/flink/jitsql/bench/CudfGroupBySQLExample*</include>
								<include>ai/beestream/flink/jitsql/bench/BenchData*</include>
							</includes>
						</configuration>
					</execution>
					<execution>
						<id>KernelAndLibrarySQLExample</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>KernelAndLibrarySQLExample</classifier>
							<archive>
								<manifestEntries>
									<program-class>ai.beestream.flink.jitsql.bench.KernelAndLibrarySQLExample</program-class>
								</manifestEntries>
							</archive>
							<includes>
								<include>ai/beestream/flink/jitsql/bench/KernelAndLibrarySQLExample*</include>
								<include>ai/beestream/flink/jitsql/bench/BenchData*</include>
							</includes>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<id>rename</id>
						<phase>package</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<copy file="${project.build.directory}/${project.artifactId}-${project.version}-GpuOffloadExample.jar" tofile="${project.build.directory}/GpuOffloadExample.jar"/>
								<copy file="${project.build.directory}/${project.artifactId}-${project.version}-DeviceConformanceSuite.jar" tofile="${project.build.directory}/DeviceConformanceSuite.jar"/>
								<copy file="${project.build.directory}/${project.artifactId}-${project.version}-MixedTypeVerification.jar" tofile="${project.build.directory}/MixedTypeVerification.jar"/>
								<copy file="${project.build.directory}/${project.artifactId}-${project.version}-HaversineSQLExample.jar" tofile="${project.build.directory}/HaversineSQLExample.jar"/>
								<copy file="${project.build.directory}/${project.artifactId}-${project.version}-CudfSortSQLExample.jar" tofile="${project.build.directory}/CudfSortSQLExample.jar"/>
															<copy file="${project.build.directory}/${project.artifactId}-${project.version}-CudfGroupBySQLExample.jar" tofile="${project.build.directory}/CudfGroupBySQLExample.jar"/>
								<copy file="${project.build.directory}/${project.artifactId}-${project.version}-RiskScoringSQLExample.jar" tofile="${project.build.directory}/RiskScoringSQLExample.jar"/>
								<copy file="${project.build.directory}/${project.artifactId}-${project.version}-GramParquetSQLExample.jar" tofile="${project.build.directory}/GramParquetSQLExample.jar"/>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
